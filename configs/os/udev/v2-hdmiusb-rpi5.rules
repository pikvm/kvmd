# https://unix.stackexchange.com/questions/66901/how-to-bind-usb-device-under-a-static-name
# https://wiki.archlinux.org/index.php/Udev#Setting_static_device_names

ACTION=="remove", GOTO="end"

KERNEL=="video[0-9]*", SUBSYSTEM=="video4linux", ATTRS{bInterfaceNumber}=="?*", \
	PROGRAM="/usr/lib/kvmd/kvmd-udev-hdmiusb-check rpi5 %b", ATTR{index}=="0", \
		GROUP="kvmd", SYMLINK+="kvmd-video"

KERNEL=="hidg0", GROUP="kvmd", SYMLINK+="kvmd-hid-keyboard"
KERNEL=="hidg1", GROUP="kvmd", SYMLINK+="kvmd-hid-mouse"
KERNEL=="hidg2", GROUP="kvmd", SYMLINK+="kvmd-hid-mouse-alt"

SUBSYSTEM=="gpio", ENV{DEVTYPE}=="gpio_chip", KERNEL=="gpiochip*", \
	ENV{OF_COMPATIBLE_0}=="raspberrypi,rp1-gpio", \
		SYMLINK+="kvmd-gpio"

LABEL="end"
