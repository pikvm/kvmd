li.right#system-dropdown
	.menu-item.menu-button(href="#")
		+navbar_led("link-led", "led-link")
		+navbar_led("stream-led", "led-video")
		+navbar_led("hid-keyboard-led", "led-hid-keyboard")
		+navbar_led("hid-mouse-led", "led-hid-mouse")
		span System

	.hidden.menu#system-menu
		table.kv
			tr
				td.value
					| Runtime settings &amp; tools
				td.feature-disabled#system-tool-webterm
					button.small(data-wm-menu-force-hide data-wm-window-show="webterm-window") &bull; Term
				td#system-tool-about
					button.small(data-wm-menu-force-hide data-wm-window-show="about-window") &bull; About
				td#system-tool-log
					button.small#open-log-button(data-wm-menu-force-hide) &bull; Log
				td.feature-disabled#system-tool-wol
					button(
						data-wm-menu-force-hide
						class="__gpio-button-__wol__ __gpio-button small"
						data-gpio-channel="__wol__"
						data-gpio-confirm="Are you sure to send Wake-on-LAN packet to the server?"
					) &bull; WoL

		hr

		table.kv
			tr
				td Bad link mode (release keys immediately):
				td #[+menu_switch("hid-keyboard-bad-link-switch", true, false)]
			tr
				td Mute keyboard &amp; mouse (HID):
				td #[+menu_switch("hid-mute-switch", true, false)]
			tr.feature-disabled#hid-jiggler
				td #[a(target="_blank" href="https://docs.pikvm.org/mouse_jiggler") Mouse jiggler]:
				td #[+menu_switch("hid-jiggler-switch", false, false)]

		hr

		.hidden#stream-message-no-webrtc
			+menu_message("warning", "WebRTC is not supported by this browser")
			hr
		.hidden#stream-message-no-vd
			+menu_message("warning", "Direct H.264 streaming is not supported")
			hr
		.hidden#stream-message-no-h264
			+menu_message("warning", "H.264 is not supported by this browser")
			hr

		table.kv
			tr.feature-disabled#stream-resolution
				td Resolution:
				td #[select.small#stream-resolution-selector(disabled)]
			tr.feature-disabled#stream-mode
				td #[a(target="_blank" href="https://docs.pikvm.org/webrtc") Video mode]:
				td
					+menu_radio("stream-mode-radio", [
						{title: "WebRTC<br>H.264", value: "janus"},
						{title: "Direct<br>H.264", value: "media"},
						{title: "Legacy<br>MJPEG", value: "mjpeg", checked: true},
					])
			tr.feature-disabled#stream-orient
				td Orientation:
				td
					+menu_radio("stream-orient-radio", [
						{title: "Default", value: "0", checked: true},
						{title: "90&deg;", value: "90"},
						{title: "180&deg;", value: "180"},
						{title: "270&deg;", value: "270"},
					])

		+menu_spoiler("Video quality settings")
			table.kv
				tr
					td FPS limit:
					td.slider #[+menu_slider("stream-desired-fps-slider", "stream-desired-fps-value", false)]
				tr.feature-disabled#stream-quality
					td JPEG quality:
					td.slider #[+menu_slider("stream-quality-slider", "stream-quality-value", false)]
				tr.feature-disabled#stream-h264-bitrate
					td H.264 kbps:
					td.slider #[+menu_slider("stream-h264-bitrate-slider", "stream-h264-bitrate-value", false)]
				tr.feature-disabled#stream-h264-gop
					td #[a(target="_blank" href="https://docs.pikvm.org/video#settings") H.264 gop]:
					td.slider #[+menu_slider("stream-h264-gop-slider", "stream-h264-gop-value", false)]

		table.kv.feature-disabled#stream-multimedia
			tr
				td Enable multimedia:
				td #[+menu_switch("stream-multimedia-switch", true, false)]
			tr.feature-disabled#stream-audio
				td Audio volume:
				td.slider #[+menu_slider("stream-audio-volume-slider", "stream-audio-volume-value", false)]
			tr.feature-disabled#stream-mic
				td Microphone:
				td #[+menu_switch("stream-mic-switch", false, false)]
			tr.feature-disabled#stream-camera
				td Camera:
				td #[+menu_switch("stream-camera-switch", false, false)]

		.buttons.buttons-row
			button.row33(data-wm-menu-force-hide data-wm-window-show="stream-window") &bull; Show stream
			button.row33#stream-screenshot-button(data-wm-menu-force-hide) &bull; Screenshot
			button.row33#stream-reset-button Reset stream

		table.kv
			tr.feature-disabled#hid-outputs-keyboard
				td Keyboard mode:
				td #[div.radio-box#hid-outputs-keyboard-box]
			tr.feature-disabled#hid-outputs-mouse
				td #[a(target="_blank" href="https://docs.pikvm.org/mouse") Mouse mode]:
				td #[div.radio-box#hid-outputs-mouse-box]
			tr
				td #[a(target="_blank" href="https://docs.pikvm.org/shortcuts") Shortcuts magic]:
				td #[select.small#hid-keyboard-magic-selector]

		+menu_spoiler("Keyboard &amp; mouse (HID) settings")
			table(class="kv")
				tr
					td Sync Caps Lock state to the host:#[br]#[i (Requires working Caps led)]
					td #[+menu_switch("hid-keyboard-sync-caps-switch", true, false)]
				tr
					td Swap Left Ctrl and Caps keys:
					td #[+menu_switch("hid-keyboard-swap-cc-switch", true, false)]
			hr
			table(class="kv")
				tr
					td Mouse polling
					td.slider #[+menu_slider("hid-mouse-rate-slider", "hid-mouse-rate-value")]
				tr.feature-disabled#hid-mouse-sens
					td Relative sensitivity:
					td.slider #[+menu_slider("hid-mouse-sens-slider", "hid-mouse-sens-value", false)]
				tr.feature-disabled#hid-mouse-boost
					td Relative boost factor:#[br]#[i (Firefox on Wayland)]
					td.slider #[+menu_slider("hid-mouse-boost-slider", "hid-mouse-boost-value", false)]
				tr(id="hid-mouse-squash" class="feature-disabled")
					td Squash relative moves:
					td #[+menu_switch("hid-mouse-squash-switch", true, true)]
				tr
					td Reverse scrolling:
					td
						table
							tr
								td Vert:
								td #[+menu_switch("hid-mouse-reverse-scrolling-y-switch", true, false)]
								td &nbsp;&nbsp;
								td Horiz:
								td #[+menu_switch("hid-mouse-reverse-scrolling-x-switch", true, false)]
				tr
					td Cumulative scrolling:
					td #[+menu_switch("hid-mouse-cumulative-scrolling-switch", true, false)]
				tr
					td Scroll rate:
					td.slider #[+menu_slider("hid-mouse-scroll-slider", "hid-mouse-scroll-value")]
				tr
					td Show the blue dot:
					td #[+menu_switch("hid-mouse-dot-switch", true, true)]

		+menu_spoiler("Interface settings")
			table.kv
				tr
					td Interface style:
					td
						+menu_radio("page-ui-type-radio", [
							{title: "Auto", value: "auto", checked: true},
							{title: "Desktop", value: "desktop"},
							{title: "Mobile", value: "mobile"},
						])
			hr
			table.kv
				tr
					td Ask page close confirmation:
					td #[+menu_switch("page-close-ask-switch", true, true)]
				tr
					td Expand for the entire tab by default:
					td #[+menu_switch("page-full-tab-stream-switch", true, false)]
				tr
					td Suspend stream when tab is not active:
					td #[+menu_switch("stream-suspend-switch", true, false)]

		table.kv
			tr.feature-disabled#hid-connect
				td Connect HID to Server:
				td #[+menu_switch("hid-connect-switch", true, true)]
			tr.feature-disabled#v3-usb-breaker
				td Connect main USB to Server:
				td
					+menu_switch_gpio(
						"__v3_usb_breaker__",
						"Turning off this switch will disconnect the main USB from the server.  Are you sure you want to continue?"
					)
			tr.feature-disabled#v4-locator
				td Enable locator LED:
				td #[+menu_switch_gpio("__v4_locator__")]

		.buttons.buttons-row
			button.row33(data-wm-menu-force-hide data-wm-window-show="keyboard-window") &bull; Keyboard
			button.row33(data-wm-menu-force-hide data-wm-window-show="mouse-window") &bull; Mouse
			button.row33#hid-reset-button(disabled) Reset HID
